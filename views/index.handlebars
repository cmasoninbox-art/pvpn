  <script>
    // Disable right-click everywhere on this page
    document.addEventListener('contextmenu', (e) => { e.preventDefault(); return false; });

    // Server-rendered customizable tease buttons (label + destination)
    window.AD_BUTTONS = {{{adButtonsJson}}};

    const SPLASH = {
      title: document.getElementById('splashTitle')?.textContent || 'Premium Required',
      body: document.getElementById('splashBody')?.textContent || 'Search is for premium users only.',
      links: [
        { href: 'https://www.google.com', text: 'Google' },
        { href: 'https://www.github.com', text: 'GitHub' },
        { href: 'https://www.wikipedia.org', text: 'Wikipedia' },
      ],
    };

    function applySplash() {
      const title = document.getElementById('splashTitle');
      const body = document.getElementById('splashBody');
      const container = document.getElementById('splashLinks');
      if (title) title.textContent = SPLASH.title;
      if (body) body.textContent = SPLASH.body;
      if (container) {
        container.innerHTML = '';
        SPLASH.links.forEach(link => {
          const a = document.createElement('a');
          a.className = 'pill';
          a.href = link.href;
          a.target = '_blank';
          a.rel = 'noopener';
          a.textContent = link.text;
          container.appendChild(a);
        });
      }
    }

    applySplash();

    const premiumPartyBtn = document.getElementById('premiumPartyBtn');
    const loginMenu = document.getElementById('loginMenu');
    const loginForm = document.getElementById('loginForm');
    const loginMsg = document.getElementById('loginMsg');
    const loginClose = document.getElementById('loginClose');

    if (premiumPartyBtn) {
      premiumPartyBtn.addEventListener('click', () => {
        window.location.href = '/premium';   // Premium Party button -> payment wall
      });
    }
    if (loginClose && loginMenu) {
      loginClose.addEventListener('click', () => {
        loginMenu.style.display = 'none';
      });
    }
    if (loginForm) {
      loginForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const user = document.getElementById('loginUser').value.trim();
        const pass = document.getElementById('loginPass').value;
        if (!user || !pass) { loginMsg.textContent = 'Enter username and password'; return; }
        loginMsg.textContent = 'Checking...';
        fetch('/api/login', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: user, password: pass })
        }).then(r => r.json().then(j => ({ ok: r.ok, j }))).then(({ ok, j }) => {
          if (!ok || !j.ok) { loginMsg.textContent = (j && j.error) || 'Login failed'; return; }
          loginMsg.textContent = 'Welcome, ' + j.user.username + '!';
          applyUserState(j.user);
          setTimeout(() => {
            loginMenu.style.display = 'none';
            if (j.user.premium) { unlockPremiumUI(); }
            else { alert('Logged in. Premium is unlocked by purchasing a plan.'); }
          }, 600);
        }).catch(() => { loginMsg.textContent = 'Network error'; });
      });
    }

    const toggleRegister = document.getElementById('toggleRegister');
    const registerForm = document.getElementById('registerForm');
    const partyTitle = document.getElementById('partyTitle');
    const loginFormEl = document.getElementById('loginForm');

    function showRegister() {
      loginFormEl.style.display = 'none';
      registerForm.style.display = 'flex';
      partyTitle.textContent = 'Premium Party Register';
      toggleRegister.textContent = 'Have an account? Login';
    }
    function showLogin() {
      registerForm.style.display = 'none';
      loginFormEl.style.display = 'flex';
      partyTitle.textContent = 'Premium Party Login';
      toggleRegister.textContent = 'No account? Register';
    }

    if (toggleRegister && registerForm) {
      toggleRegister.addEventListener('click', () => {
        if (registerForm.style.display === 'flex') showLogin();
        else showRegister();
      });
    }

    // --- Browser-section gate (FREE / Premium Palace) ---
    const browserGate = document.getElementById('browserGate');
    const gateFreeBtn = document.getElementById('gateFreeBtn');
    const gatePremiumBtn = document.getElementById('gatePremiumBtn');

    function removeBrowserGate() {
      if (browserGate) browserGate.classList.add('hidden');
      const frame = document.getElementById('frame');
      if (frame) frame.style.pointerEvents = 'auto';
    }
    function showBrowserGate() {
      const premium = localStorage.getItem('premium') === '1';
      const free = localStorage.getItem('freeAccess') === '1';
      if (browserGate) browserGate.classList.toggle('hidden', premium || free);
    }

    if (gateFreeBtn) {
      gateFreeBtn.addEventListener('click', () => {
        try { localStorage.setItem('freeAccess', '1'); } catch (_) {}
        removeBrowserGate();
        const frame = document.getElementById('frame');
        if (frame) {
          // Use /go with embedded=1 — full URL rewriting (all links → /go?url=…)
          // plus anti-bust injection.  No frame-bust because navigation stays
          // same-origin (everything is /go?url=… on our host).
          const proxyUrl = '/go?url=' + encodeURIComponent('https://www.pornhub.com') + '&embedded=1&country=us&premium=0';
          frame.dataset.proxyUrl = proxyUrl;
          frame.dataset.loading = '1';
          frame.src = proxyUrl;
        }
      });
    }

    // --- Frame-bust watchdog (backstop) ---
    // Only fires when the frame is NOT loading (proxy fetch takes 2-3s on Render).
    // During load the contentWindow check throws (not ready), which we'd mistake for
    // cross-origin and reset — creating an infinite loop that shows a blank frame.
    const frameWatchdog = setInterval(() => {
      const frame = document.getElementById('frame');
      if (!frame || !frame.dataset.proxyUrl) return;
      if (frame.dataset.loading === '1') return;  // skip during active fetch
      let sameOrigin = true;
      try { void frame.contentWindow.location.href; } catch (_) { sameOrigin = false; }
      if (!sameOrigin) {
        const back = frame.dataset.proxyUrl;
        frame.dataset.loading = '1';
        frame.src = back + (back.indexOf('?') > -1 ? '&' : '?') + '_w=' + Date.now();
      }
    }, 800);

    // Track the last good proxy URL + clear loading flag on successful load.
    const frameEl = document.getElementById('frame');
    if (frameEl) {
      frameEl.addEventListener('load', () => {
        frameEl.dataset.loading = '0';
        try {
          const loc = frameEl.contentWindow.location.href;
          if (loc && (loc.indexOf('/proxy') > -1 || loc.indexOf('/go') > -1)) frameEl.dataset.proxyUrl = loc;
        } catch (_) { /* cross-origin — watchdog handles */ }
      });
    }
    if (gatePremiumBtn) {
      gatePremiumBtn.addEventListener('click', () => {
        window.location.href = '/premium';   // Premium Palace -> payment wall
      });
    }

    // On successful premium login, also drop the browser gate (all blocks removed).
    function unlockPremiumUI() {
      const gate = document.getElementById('premiumGate');
      if (gate) gate.style.display = 'none';
      const goBtn = document.querySelector('.nav button[type="submit"]');
      if (goBtn) goBtn.disabled = false;
      const inputEl = document.getElementById('url');
      if (inputEl) { inputEl.disabled = false; inputEl.placeholder = 'Enter website or search...'; }
      removeBrowserGate();
      const browserFrame = document.getElementById('frame');
      if (browserFrame) {
        const currentSrc = browserFrame.getAttribute('src') || '';
        if (currentSrc.includes('premium=0')) {
          browserFrame.src = currentSrc.replace('premium=0', 'premium=1');
        } else if (!currentSrc) {
          const countryEl = document.getElementById('country');
          const country = countryEl ? (countryEl.value || 'us') : 'us';
          browserFrame.src = '/proxy?url=' + encodeURIComponent('https://www.pornhub.com') +
            '&country=' + encodeURIComponent(country) + '&premium=1';
        }
        const displayEl = document.getElementById('displayUrl');
        if (displayEl) displayEl.textContent = 'pornhub.com';
      }
    }

    if (registerForm) {
      registerForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const user = document.getElementById('regUser').value.trim();
        const email = document.getElementById('regEmail').value.trim();
        const pass = document.getElementById('regPass').value.trim();
        const confirm = document.getElementById('regConfirm').value.trim();
        if (!user || !email || !pass) { loginMsg.textContent = 'Fill in all fields'; return; }
        if (pass !== confirm) { loginMsg.textContent = 'Passwords do not match'; return; }
        loginMsg.textContent = 'Creating account...';
        fetch('/api/register', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: user, email, password: pass })
        }).then(r => r.json().then(j => ({ ok: r.ok, j }))).then(({ ok, j }) => {
          if (!ok || !j.ok) { loginMsg.textContent = (j && j.error) || 'Registration failed'; return; }
          loginMsg.textContent = 'Account created, ' + j.user.username + '!';
          applyUserState(j.user);
          setTimeout(() => {
            loginMenu.style.display = 'none';
            // Accounts are free by default — premium requires a paid plan.
            alert('Account created! Log in and buy a plan to unlock premium.');
          }, 600);
        }).catch(() => { loginMsg.textContent = 'Network error'; });
      });
    }

    // Apply server-authoritative user state (premium only if the backend says so).
    function applyUserState(user) {
      if (!user) { localStorage.removeItem('premium'); localStorage.removeItem('premiumUser'); return; }
      localStorage.setItem('premiumUser', user.username);
      if (user.premium) { localStorage.setItem('premium', '1'); }
      else { localStorage.removeItem('premium'); }
    }

    // On page load, ask the server who we are (cookie-based session).
    fetch('/api/me').then(r => r.json()).then(d => {
      if (d && d.ok && d.user) {
        applyUserState(d.user);
        const lb = document.getElementById('logoutBtn'); if (lb) lb.style.display = 'block';
        if (d.user.premium) {
          unlockPremiumUI();
          applySearchLock();
          applyMediaGate();
          applyVpnGate();
          applyTease();
        }
      } else {
