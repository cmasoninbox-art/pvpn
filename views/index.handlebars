        menuDropdown.classList.remove('open');
        showRegister();
        if (loginMenu) loginMenu.style.display = 'flex';
      } else if (action === 'logout') {
        fetch('/api/logout', { method: 'POST' }).then(() => {
          localStorage.removeItem('premium'); localStorage.removeItem('premiumUser');
          const lb = document.getElementById('logoutBtn'); if (lb) lb.style.display = 'none';
          alert('Logged out.');
        }).catch(() => {});
      } else if (action === 'categories') {
        alert('Categories page placeholder');
      } else if (action === 'top') {
        alert('Top Pages placeholder');
      } else if (action === 'local') {
        alert('Local Pages placeholder');
      } else if (action === 'admin') {
        // Load admin panel inside the same browser frame (no new tab)
        display.textContent = '/admin-login';
        frame.src = '/admin-login';
        setConnected();
      } else if (action === 'shop') {
        display.textContent = '/shop';
        frame.src = '/shop';
        setConnected();
      } else if (action === 'forum') {
        display.textContent = '/forum';
        frame.src = '/forum';
        setConnected();
      } else if (action === 'polls') {
        display.textContent = '/forum#polls';
        frame.src = '/forum';
        setConnected();
        // Switch to polls tab after load
        setTimeout(() => {
          try { frame.contentDocument.querySelector('[data-tab="polls"]').click(); } catch(_) {}
        }, 1000);
      } else if (action === 'top100') {
