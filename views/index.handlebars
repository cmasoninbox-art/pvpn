          if (!raw) return null;
          const record = JSON.parse(raw);
          if (Date.now() - record.ts > 3600000) {
            localStorage.removeItem('ageChoice');
            return null;
          }
          return record.value;
        } catch (_) {
          return null;
        }
      }

      function showMessage(title, text) {
        ageActions.style.display = 'none';
        ageTitle.textContent = title;
        ageText.textContent = text;
        ageText.style.color = '#ff7a00';
        ageText.style.fontSize = '20px';
        ageText.style.fontWeight = '900';
        ageText.style.textTransform = 'uppercase';
      }

      function unlock() {
        gate.style.display = 'none';
        if (layout) layout.style.display = 'flex';
      }

      const choice = getChoice();
      if (choice === 'yes') {
        unlock();
        alert('Have fun legend');
      } else if (choice === 'no') {
        showMessage('No Entry', 'Grow up, come back later bud!');
        if (layout) layout.style.display = 'none';
      } else {
        gate.style.display = 'flex';
        if (layout) layout.style.display = 'none';
      }

      document.getElementById('ageYes').addEventListener('click', function() {
        setChoice('yes');
        unlock();
        showBrowserGate();
        alert('Have fun legend');
      });
      document.getElementById('ageNo').addEventListener('click', function() {
        setChoice('no');
        showMessage('No Entry', 'Grow up, come back later bud!');
        if (layout) layout.style.display = 'none';
      });
    })();
  </script>
