        frame.src = '/forum';
        setConnected();
        setTimeout(() => {
          try { frame.contentDocument.querySelector('[data-tab="hottest"]').click(); } catch(_) {}
        }, 1000);
      }
    });

    // Offer links from the burger menu -> load in the same browser frame
    const OFFER_URLS = {
      hot: 'https://example.com', save: 'https://example.com', limited: 'https://example.com',
      gift: 'https://example.com', go: 'https://example.com', top: 'https://example.com',
      trending: 'https://example.com', secure: 'https://example.com', premium: 'https://example.com',
      match: 'https://example.com'
    };
    menuDropdown.addEventListener('click', (e) => {
      const offerBtn = e.target.closest('[data-offer]');
      if (!offerBtn) return;
      const key = offerBtn.getAttribute('data-offer');
      const target = OFFER_URLS[key] || 'https://example.com';
      menuDropdown.classList.remove('open');
      display.textContent = target;
      frame.src = '/proxy?url=' + encodeURIComponent(target);
      setConnected();
    });

    const vpnMode = document.getElementById('vpnMode');
    const localProxy = document.getElementById('localProxy');
    vpnMode.addEventListener('change', () => {
      localProxy.style.display = vpnMode.value === 'local' ? 'inline-block' : 'none';
      saveSettings();
    });

    async function loadSettings() {
      try {
        const res = await fetch('/vpn-settings');
        const data = await res.json();
        if (data.localProxy) localProxy.value = data.localProxy;
        if (data.vpnMode) vpnMode.value = data.vpnMode;
        else if (typeof data.builtinProxyEnabled !== 'undefined') {
          vpnMode.value = data.builtinProxyEnabled ? 'builtin' : 'local';
        }
        localProxy.style.display = vpnMode.value === 'local' ? 'inline-block' : 'none';
      } catch (_) {}
    }

    async function saveSettings() {
      try {
        await fetch('/vpn-settings', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ vpnMode: vpnMode.value, localProxy: localProxy.value.trim(), builtinProxyEnabled: vpnMode.value === 'builtin' }),
        });
      } catch (_) {}
    }

    localProxy.addEventListener('input', saveSettings);

    function buildProxyUrl(query) {
      const countrySel = document.getElementById('country');
      if (vpnMode.value === 'local') {
        const base = (localProxy.value || '').trim().replace(/\/$/, '');
        return base + (base ? '/' : '') + query;
      }
      const premium = localStorage.getItem('premium') === '1';
      const country = premium ? (countrySel.value || 'us') : 'us';
      return '/proxy?url=' + encodeURIComponent(query) + '&country=' + encodeURIComponent(country) + '&premium=' + (premium ? '1' : '0');
    }

    document.getElementById('fsBtn').addEventListener('click', () => {
      const iframe = document.getElementById('frame');
      if (iframe.requestFullscreen) iframe.requestFullscreen();
      else if (iframe.webkitRequestFullscreen) iframe.webkitRequestFullscreen();
      else if (iframe.msRequestFullscreen) iframe.msRequestFullscreen();
    });

    document.getElementById('refreshBtn').addEventListener('click', () => {
      const iframe = document.getElementById('frame');
      iframe.src = iframe.src;
    });

    document.getElementById('openTabBtn').addEventListener('click', () => {
      const iframe = document.getElementById('frame');
      const display = document.getElementById('displayUrl');
      let src = iframe.src;
      if (!src || src === 'about:blank' || src === window.location.href) {
        const fallback = display.textContent && display.textContent !== 'No page loaded' ? display.textContent : '/proxy?url=' + encodeURIComponent('https://www.pornhub.com') + '&country=us&premium=0';
        src = fallback.startsWith('http') ? fallback : window.location.origin + fallback;
      }
      window.open(src, '_blank');
    });

    document.getElementById('homeBtn').addEventListener('click', () => {
      document.getElementById('url').value = '';
      document.getElementById('frame').src = 'about:blank';
      display.textContent = '';
    });

    const zoomFrame = document.getElementById('frame');
    let zoomLevel = window.matchMedia('(max-width: 760px)').matches ? 0.25 : 1;
    function applyFrameZoom() {
      try {
        const frameDoc = zoomFrame.contentDocument;
        if (frameDoc && frameDoc.documentElement && zoomFrame.src !== 'about:blank') {
          frameDoc.documentElement.style.setProperty('zoom', String(zoomLevel), 'important');
          frameDoc.documentElement.style.setProperty('width', (100 / zoomLevel) + '%', 'important');
          zoomFrame.style.removeProperty('zoom');
          zoomFrame.style.width = '100%';
          return;
        }
      } catch (e) {}
      zoomFrame.style.zoom = zoomLevel;
      zoomFrame.style.width = (100 / zoomLevel) + '%';
    }
    zoomFrame.addEventListener('load', () => setTimeout(applyFrameZoom, 120));
    applyFrameZoom();
    document.getElementById('zoomInBtn').addEventListener('click', () => {
      zoomLevel = Math.min(3, zoomLevel + 0.1);
      applyFrameZoom();
    });
    document.getElementById('zoomOutBtn').addEventListener('click', () => {
      zoomLevel = Math.max(0.3, zoomLevel - 0.1);
      applyFrameZoom();
    });

    document.getElementById('bookmarkBtn').addEventListener('click', () => {
      const url = display.textContent;
      if (!url || url === window.location.href) return;
      const bookmarks = JSON.parse(localStorage.getItem('bookmarks') || '[]');
      bookmarks.unshift({ url, title: new URL(url).hostname, ts: Date.now() });
      localStorage.setItem('bookmarks', JSON.stringify(bookmarks.slice(0, 50)));
      alert('Bookmarked: ' + url);
    });

    document.getElementById('historyBtn').addEventListener('click', () => {
      const history = JSON.parse(localStorage.getItem('history') || '[]');
      if (!history.length) return alert('No history yet');
      const list = history.slice(0, 20).map((h, i) => (i + 1) + '. ' + h.url).join('\n');
      alert('Recent history:\n\n' + list);
    });

    let darkTheme = true;
    document.getElementById('themeBtn').addEventListener('click', () => {
      darkTheme = !darkTheme;
      document.body.style.background = darkTheme ? '#000' : '#fff';
      document.body.style.color = darkTheme ? '#fff' : '#000';
      document.querySelector('.toolbar').style.background = darkTheme ? '#111' : '#eee';
      document.querySelector('.toolbar').style.color = darkTheme ? '#ff7a00' : '#333';
    });

    document.getElementById('speedBtn').addEventListener('click', async () => {
      const btn = document.getElementById('speedBtn');
      btn.disabled = true;
      btn.textContent = '...';
      try {
        const start = performance.now();
        await fetch('/proxy?url=' + encodeURIComponent('https://www.google.com/generate_204'), {
          headers: { 'Cache-Control': 'no-cache', 'Pragma': 'no-cache' },
          signal: AbortSignal.timeout(8000),
        });
        const ms = Math.round(performance.now() - start);
        alert('Ping: ' + ms + 'ms');
      } catch (e) {
        alert('Speed test failed: ' + e.message);
      } finally {
        btn.disabled = false;
        btn.textContent = '⚡';
      }
    });

    // Track browsing history
    const originalBuildProxyUrl = buildProxyUrl;
    window.buildProxyUrl = function(query) {
      try {
        const history = JSON.parse(localStorage.getItem('history') || '[]');
        history.unshift({ url: query, ts: Date.now() });
        localStorage.setItem('history', JSON.stringify(history.slice(0, 100)));
      } catch (_) {}
      return originalBuildProxyUrl(query);
    };

    function applySearchLock() {
      const premium = localStorage.getItem('premium') === '1';
      input.disabled = !premium;
      const goBtn = document.querySelector('.nav button[type="submit"]');
      if (goBtn) goBtn.disabled = !premium;
      if (!premium) {
        input.placeholder = 'Search locked — upgrade to premium';
      } else {
        input.placeholder = 'Enter website or search...';
      }
    }

    const videoQuality = document.getElementById('videoQuality');
    const playbackSpeed = document.getElementById('playbackSpeed');
    const subtitleToggle = document.getElementById('subtitleToggle');
    const mediaLock = document.getElementById('mediaLock');

    function applyMediaGate() {
      const premium = localStorage.getItem('premium') === '1';
      if (videoQuality) {
        for (const opt of videoQuality.options) {
          const locked = opt.dataset.premium === '1' && !premium;
          opt.disabled = locked;
        }
        if (!premium && videoQuality.value !== '480') {
          videoQuality.value = '480';
        }
        videoQuality.disabled = false; // selector stays usable; non-premium options are disabled
      }
      if (mediaLock) {
        mediaLock.textContent = premium ? '' : 'Non-premium: locked to 480p';
      }
      saveMediaSettings();
      enforceMedia();
    }

    // VPN tier gate: free users only get the slow built-in (Tor) node;
    // country selection + faster nodes unlock with premium.
    function applyVpnGate() {
      const premium = localStorage.getItem('premium') === '1';
      const countrySel = document.getElementById('country');
      const vpnSel = document.getElementById('vpnMode');
      const vpnNote = document.getElementById('vpnNote');
      if (vpnSel) {
        vpnSel.value = 'direct';
        vpnSel.disabled = !premium;
      }
      if (countrySel) {
        if (!premium) countrySel.value = 'us';
        countrySel.disabled = !premium;
      }
      if (vpnNote) vpnNote.textContent = premium ? 'Direct egress — no VPN/Tor' : 'Free: direct egress — upgrade for VPN';
      setDirectMode();
    }

    // Non-premium tease screen: dark translucent overlay covering the browser,
    // 3 customizable yellow buttons. Premium OR free-access users get the browser.
    function applyTease() {
      const premium = localStorage.getItem('premium') === '1';
      const free = localStorage.getItem('freeAccess') === '1';
      const unlocked = premium || free;
      const gate = document.getElementById('browserGate');
      if (gate) gate.classList.toggle('hidden', unlocked);
      const frame = document.getElementById('frame');
      if (frame) frame.style.pointerEvents = unlocked ? 'auto' : 'none';
    }

    // Render the 3 customizable buttons from server config (label + destination).
    function applyAdButtons() {
      const host = document.getElementById('teaseBtns');
      if (!host) return;
      const btns = (window.AD_BUTTONS && window.AD_BUTTONS.length) ? window.AD_BUTTONS : [
        { label: 'HOT DEALS', url: 'https://example.com' },
        { label: 'GO PREMIUM', url: 'https://example.com' },
        { label: 'FREE GIFT', url: 'https://example.com' },
      ];
      host.innerHTML = '';
      btns.slice(0, 3).forEach(b => {
        const el = document.createElement('button');
        el.className = 'tease-btn';
        el.textContent = b.label || 'BUTTON';
        el.addEventListener('click', () => {
          if (b.free) {
            // FREE: unlock the browser only (search stays locked) and load the frame
            // straight to the destination through the built-in VPN.
            try { localStorage.setItem('freeAccess', '1'); } catch (_) {}
            const overlay = document.getElementById('teaseOverlay');
            if (overlay) overlay.classList.remove('show');
            const frame = document.getElementById('frame');
            if (frame) {
              frame.style.pointerEvents = 'auto';
              const dest = b.url || 'https://www.pornhub.com';
              frame.src = '/proxy?url=' + encodeURIComponent(dest) + '&country=us&premium=0';
            }
            return;
          }
          const url = b.url || 'https://example.com';
          if (url.startsWith('http')) window.open(url, '_blank', 'noopener');
        });
        host.appendChild(el);
      });
    }

    function saveMediaSettings() {
      const payload = {
        quality: videoQuality ? videoQuality.value : '480',
        speed: playbackSpeed ? playbackSpeed.value : '1',
        subtitles: subtitleToggle ? subtitleToggle.value : 'off'
      };
      try { localStorage.setItem('mediaSettings', JSON.stringify(payload)); } catch (_) {}
      try {
        fetch('/media-settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        }).catch(() => {});
      } catch (_) {}
    }

    function enforceMedia() {
      const premium = localStorage.getItem('premium') === '1';
      const frameDoc = (() => { try { return frame.contentDocument; } catch (_) { return null; } })();
      if (!frameDoc) return; // cross-origin: cannot reach into proxied site's video
      frameDoc.querySelectorAll('video').forEach(v => {
        if (!premium && v.videoHeight > 480) {
          // try to nudge down via height; true resolution is site-controlled
          v.style.maxHeight = '480px';
        }
        try {
          if (playbackSpeed) v.playbackRate = parseFloat(playbackSpeed.value) || 1;
          const tracks = v.textTracks;
          if (tracks && subtitleToggle) {
            for (let i = 0; i < tracks.length; i++) {
              tracks[i].mode = subtitleToggle.value === 'on' ? 'showing' : 'hidden';
            }
          }
        } catch (_) {}
      });
    }

    if (videoQuality) videoQuality.addEventListener('change', () => {
      const opt = videoQuality.options[videoQuality.selectedIndex];
      if (opt.dataset.premium === '1' && localStorage.getItem('premium') !== '1') {
        videoQuality.value = '480';
        alert('720p/1080p require Premium Party');
        return;
      }
      saveMediaSettings();
      enforceMedia();
    });
    if (playbackSpeed) playbackSpeed.addEventListener('change', () => { saveMediaSettings(); enforceMedia(); });
    if (subtitleToggle) subtitleToggle.addEventListener('change', () => { saveMediaSettings(); enforceMedia(); });

    frame.addEventListener('load', enforceMedia);

    loadSettings();
    applySearchLock();
    applyMediaGate();
    applyVpnGate();
    applyTease();
    applyAdButtons();

    // Auto-load Pornhub on page start (no click needed)
    (function autoLoadBrowser() {
      const frame = document.getElementById('frame');
      const free = localStorage.getItem('freeAccess') === '1';
      const premium = localStorage.getItem('premium') === '1';
      if (frame && (free || premium)) {
        frame.src = '/proxy?url=' + encodeURIComponent('https://www.pornhub.com') + '&country=us&premium=' + (premium ? '1' : '0');
        const du = document.getElementById('displayUrl');
        if (du) du.textContent = 'pornhub.com';
      }
    })();
    window.addEventListener('storage', () => { applySearchLock(); applyMediaGate(); applyVpnGate(); applyTease(); applyAdButtons(); });

    document.getElementById('navForm').addEventListener('submit', function(e) {
      // ALWAYS block native submit — otherwise the whole page reloads (the "refresh on search" bug)
      e.preventDefault();
      const premium = localStorage.getItem('premium') === '1';
      if (!premium) {
        document.getElementById('premiumGate').style.display = 'flex';
        return;
      }
      let query = input.value.trim();
      if (!query) return;
      if (!/^https?:\/\//i.test(query)) {
        const looksLikeDomain = /^(?:[a-z0-9-]+\.)+[a-z]{2,}(?::\d+)?(?:[\/\?#].*)?$/i.test(query);
        query = looksLikeDomain
          ? 'https://' + query
          : 'https://html.duckduckgo.com/html/?q=' + encodeURIComponent(query);
      }
      display.textContent = query;
      frame.src = buildProxyUrl(query);
      setConnected();
    });

    document.getElementById('premiumUpgrade').addEventListener('click', () => {
      // Route to the real payment wall — premium is granted by the Stripe webhook, not client-side.
      window.location.href = '/premium';
    });

    input.addEventListener('keydown', e => {
      if (e.key === 'Enter') document.getElementById('navForm').dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
    });

    function proxyDisplayUrl(raw) {
      try {
        const u = new URL(raw, location.origin);
        const target = u.searchParams.get('url');
        if (target) { try { return new URL(target).host; } catch(_) { return target; } }
      } catch(_) {}
      return raw;
    }

    frame.addEventListener('load', () => {
      try {
        const u = frame.contentWindow.location.href;
        if (u && u !== 'about:blank') display.textContent = proxyDisplayUrl(u);
      } catch (_) {
        // cross-origin frames throw; leave display as-is
      }
    });
  </script>
  <script>
    (function() {
      const gate = document.getElementById('ageGate');
      const ageTitle = document.getElementById('ageTitle');
      const ageText = document.getElementById('ageText');
      const ageActions = document.getElementById('ageActions');
      const layout = document.querySelector('.layout');
