<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VPN Browser</title>
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    #ageGate {
      position: fixed;
      inset: 0;
      background: #000;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      color: #ff7a00;
      font-family: Arial, sans-serif;
    }
    #ageGate .box {
      background: #111;
      border: 2px solid #ff7a00;
      padding: 24px 28px;
      max-width: 420px;
      width: 90%;
      text-align: center;
      border-radius: 6px;
      box-shadow: 0 0 40px rgba(255,122,0,0.25);
    }
    #ageGate h2 {
      margin: 0 0 12px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }
    #ageGate p {
      color: #ccc;
      margin: 0 0 18px;
    }
    #ageGate .actions {
      display: flex;
      gap: 12px;
      justify-content: center;
    }
    #ageGate button {
      background: #ff7a00;
      color: #000;
      border: 0;
      padding: 10px 16px;
      font-weight: 900;
      text-transform: uppercase;
      cursor: pointer;
      border-radius: 4px;
    }
    #ageGate button.no {
      background: #333;
      color: #ff7a00;
      border: 1px solid #ff7a00;
    }
    #premiumGate {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.85);
      align-items: center;
      justify-content: center;
      z-index: 9999;
      font-family: Arial, sans-serif;
    }
    #premiumGate .box {
      background: #111;
      border: 2px solid #ff7a00;
      padding: 24px 28px;
      max-width: 520px;
      width: 92%;
      text-align: center;
      border-radius: 6px;
      box-shadow: 0 0 40px rgba(255,122,0,0.25);
      color: #ff7a00;
    }
    #premiumGate h2 {
      margin: 0 0 10px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }
    #premiumGate p {
      color: #ccc;
      margin: 0 0 16px;
    }
    #premiumGate .actions {
      display: flex;
      gap: 12px;
      justify-content: center;
    }
    #premiumGate button {
      background: #ff7a00;
      color: #000;
      border: 0;
      padding: 10px 16px;
      font-weight: 900;
      text-transform: uppercase;
      cursor: pointer;
      border-radius: 4px;
    }
    #premiumGate .pill {
      display: inline-block;
      background: #ff7a00;
      color: #000;
      text-decoration: none;
      padding: 10px 14px;
      font-weight: 900;
      text-transform: uppercase;
      border-radius: 4px;
    }
    #premiumGate .pill:hover {
      background: #e56d00;
    }
    #loginMenu {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.85);
      align-items: center;
      justify-content: center;
      z-index: 9998;
      font-family: Arial, sans-serif;
    }
    #loginMenu .box {
      background: #111;
      border: 2px solid #ff7a00;
      padding: 24px 28px;
      max-width: 360px;
      width: 92%;
      text-align: center;
      border-radius: 6px;
      box-shadow: 0 0 40px rgba(255,122,0,0.25);
      color: #ff7a00;
    }
    #loginMenu h2 {
      margin: 0 0 10px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }

    /* Browser-section gate: SEE-THROUGH box over JUST the browser area (not full screen).
       Big yellow FREE button + Premium Palace login button, centered. */
    .browser { position: relative; }
    #browserGate {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0,0,0,0.65);   /* see-through, not a solid block */
      backdrop-filter: blur(4px);
      width: 90%;
      max-width: 500px;
    }
    #browserGate.hidden { display: none; }
    .gate-inner {
      text-align: center;
      padding: 28px 32px;
      background: rgba(10,10,10,0.85);
      border: 2px solid rgba(255,122,0,0.6);
      border-radius: 12px;
      max-width: 460px;
      width: 100%;
      box-shadow: 0 0 60px rgba(255,122,0,0.2);
    }
    .gate-title {
      color: #fff;
      font-size: 22px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 6px;
    }
    .gate-sub {
      color: #ff9000;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 20px;
    }
    .gate-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
    .gate-free {
      background: #ff9000;            /* big yellow FREE button */
      color: #000;
      border: 0;
      border-radius: 8px;
      padding: 20px 32px;
      min-width: 180px;
      font-weight: 900;
      font-size: 20px;
      text-transform: uppercase;
      letter-spacing: 1px;
      cursor: pointer;
      transition: transform 0.1s ease, filter 0.1s ease;
      box-shadow: 0 0 30px rgba(255,144,0,0.4);
    }
    .gate-free:hover { transform: translateY(-2px) scale(1.02); filter: brightness(1.08); box-shadow: 0 0 40px rgba(255,144,0,0.6); }
    .gate-premium {
      background: #111;
      color: #ff7a00;
      border: 2px solid #ff7a00;
      border-radius: 8px;
      padding: 18px 22px;
      min-width: 160px;
      font-weight: 900;
      font-size: 15px;
      text-transform: uppercase;
      letter-spacing: 1px;
      cursor: pointer;
      transition: background 0.1s ease, color 0.1s ease;
    }
    .gate-premium:hover { background: #ff7a00; color: #000; }
    .gate-close {
      background: #111;
      color: #ff7a00;
      border: 2px solid #ff7a00;
      border-radius: 50%;
      width: 44px;
      height: 44px;
      font-size: 24px;
      font-weight: 900;
      line-height: 1;
      cursor: pointer;
      transition: background 0.1s ease, color 0.1s ease;
      align-self: center;
    }
    .gate-close:hover { background: #ff7a00; color: #000; }

    /* Themes (applied via body.theme-X) */
    body.theme-default { --bg: #000; --accent: #ff7a00; --text: #fff; }
    body.theme-dark { --bg: #0a0a0a; --accent: #ff7a00; --text: #e8e8e8; }
    body.theme-blue { --bg: #04101f; --accent: #36a3ff; --text: #cfe6ff; }
    body.theme-green { --bg: #06140c; --accent: #2ecc71; --text: #d6ffe6; }
    body.theme-purple { --bg: #120618; --accent: #b06bff; --text: #ecd6ff; }
    body.theme-light { --bg: #f2f2f2; --accent: #ff7a00; --text: #111; }
    body { background: var(--bg, #000); color: var(--text, #fff); }
    .toolbar { background: var(--bg, #000); }
    .premium-party, .tease-btn { background: var(--accent, #ff7a00); }
    #premiumPartyBtn { background: #e02424 !important; color: #fff !important; }
    .vpn-note, a { color: var(--accent, #ff7a00); }

    /* Paid ads rendered on the site */
    .paid-ad { display: block; margin: 10px auto; max-width: 90%; border: 1px solid var(--accent, #ff7a00); border-radius: 6px; overflow: hidden; text-decoration: none; }
    .paid-ad img { display: block; width: 100%; }
    .paid-ad .paid-ad-label { display: block; padding: 6px 10px; color: var(--accent, #ff7a00); font-weight: 700; text-transform: uppercase; font-size: 12px; }

    /* Big red END SESSION floating button (bottom-left) */
    #floatingLogout {
      position: fixed;
      left: 16px;
      bottom: 16px;
      z-index: 9000;
      background: #e11d1d;
      color: #fff;
      border: 2px solid #ff0000;
      border-radius: 10px;
      padding: 16px 22px;
      font-size: 18px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 0 0 22px rgba(255,0,0,0.55);
    }
    #floatingLogout:hover { filter: brightness(1.12); transform: scale(1.04); }

    /* Mortal Kombat style TERMINATED screen */
    #terminatedScreen {
      position: fixed;
      inset: 0;
      z-index: 9998;
      background: #000;
      display: none;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: #ff0000;
      font-family: 'Impact', 'Arial Black', sans-serif;
    }
    #terminatedScreen.show { display: flex; }
    #terminatedScreen .mk-wrap { animation: mkPulse 0.5s ease-in-out infinite alternate; }
    #terminatedScreen .mk-top { font-size: 28px; letter-spacing: 4px; color: #fff; text-shadow: 0 0 12px #ff0000; }
    #terminatedScreen .mk-word { font-size: 120px; line-height: 1; letter-spacing: 8px; text-shadow: 0 0 30px #ff0000, 0 0 60px #ff0000; }
    #terminatedScreen .mk-sub { font-size: 22px; letter-spacing: 6px; color: #ff5252; margin-top: 10px; }
    @keyframes mkPulse { from { transform: scale(0.96); } to { transform: scale(1.06); } }
  </style>
</head>
<body class="theme-{{theme}}">
  <div id="ageGate">
    <div class="box">
      <h2 id="ageTitle">18+ Content Warning</h2>
      <p id="ageText">This site may contain adult content. Are you 18 or older?</p>
      <div class="actions" id="ageActions">
        <button id="ageYes" type="button">Yes</button>
        <button id="ageNo" class="no" type="button">No</button>
      </div>
    </div>
  </div>
  <div id="premiumGate">
    <div class="box">
      <h2 id="splashTitle">Premium Required</h2>
      <p id="splashBody">Search is for premium users only.</p>
      <div class="actions">
        <button id="premiumUpgrade" type="button">Upgrade to Premium</button>
      </div>
      <div style="margin-top:18px; display:flex; gap:12px; justify-content:center; flex-wrap:wrap;" id="splashLinks">
        <a class="pill" href="https://www.google.com" target="_blank" rel="noopener">Google</a>
        <a class="pill" href="https://www.github.com" target="_blank" rel="noopener">GitHub</a>
        <a class="pill" href="https://www.wikipedia.org" target="_blank" rel="noopener">Wikipedia</a>
      </div>
    </div>
  </div>

  <div id="loginMenu">
    <div class="box">
      <h2 id="partyTitle">Premium Party Login</h2>

      <form id="loginForm" style="display:flex; flex-direction:column; gap:10px; margin-top:12px;">
        <input id="loginUser" type="text" placeholder="Username" style="padding:8px; border-radius:3px; border:1px solid #333; background:#000; color:#fff;" />
        <input id="loginPass" type="password" placeholder="Password" style="padding:8px; border-radius:3px; border:1px solid #333; background:#000; color:#fff;" />
        <button type="submit" style="background:#ff7a00; color:#000; border:0; padding:10px; font-weight:900; text-transform:uppercase; cursor:pointer; border-radius:4px;">Enter Party</button>
      </form>

      <form id="registerForm" style="display:none; flex-direction:column; gap:10px; margin-top:12px;">
        <input id="regUser" type="text" placeholder="Username" style="padding:8px; border-radius:3px; border:1px solid #333; background:#000; color:#fff;" />
        <input id="regEmail" type="email" placeholder="Email" style="padding:8px; border-radius:3px; border:1px solid #333; background:#000; color:#fff;" />
        <input id="regPass" type="password" placeholder="Password" style="padding:8px; border-radius:3px; border:1px solid #333; background:#000; color:#fff;" />
        <input id="regConfirm" type="password" placeholder="Confirm Password" style="padding:8px; border-radius:3px; border:1px solid #333; background:#000; color:#fff;" />
        <button type="submit" style="background:#ff7a00; color:#000; border:0; padding:10px; font-weight:900; text-transform:uppercase; cursor:pointer; border-radius:4px;">Create Account</button>
      </form>

      <p id="loginMsg" style="color:#ff7a00; margin-top:10px; min-height:16px;"></p>

      <button id="toggleRegister" type="button" style="margin-top:8px; background:transparent; color:#ff7a00; border:0; cursor:pointer; text-decoration:underline; font-size:13px;">No account? Register</button>
      <button id="loginClose" type="button" style="margin-top:8px; background:transparent; color:#ff7a00; border:1px solid #ff7a00; padding:6px 12px; cursor:pointer; border-radius:4px;">Close</button>
    </div>
  </div>
  <div id="teaseOverlay" class="hidden" style="display:none"></div>
  <div class="layout">
    <div class="ad-slot ad-top" id="ad-slot-top"><a href="/donate"><img class="top-banner" src="{{bannerImage}}" alt="DONATE TO" /></a></div>

    <header class="toolbar">
      <div class="brand">
        <button type="button" id="menuBtn" title="Menu">☰</button>
        VPN Browser
        <div class="menu-dropdown" id="menuDropdown">
        <button class="menu-item heading">Account</button>
        <button class="menu-item" data-action="login">Login</button>
        <button class="menu-item" data-action="signup">Sign Up — if you're ready boys line up</button>
        <button class="menu-item" id="logoutBtn" data-action="logout" style="display:none; color:#ff7a00;">Log Out</button>
        <button class="menu-item heading" style="margin-top:6px">Pages</button>
        <button class="menu-item" data-action="shop">🏪 Shop</button>
        <button class="menu-item" data-action="admin">Admin Panel</button>
        <button class="menu-item" data-action="forum">💬 Members Forum</button>
        <button class="menu-item" data-action="polls">📊 Daily Polls</button>
        <button class="menu-item" data-action="top100">🏆 Top 100 Lists</button>
        <button class="menu-item" data-action="hottest">🔥 Hottest URLs</button>
        <button class="menu-item heading" style="margin-top:6px">Offers</button>
        <button class="menu-item" data-offer="hot">🔥 Hot Deals</button>
        <button class="menu-item" data-offer="save">💰 Save Big</button>
        <button class="menu-item" data-offer="limited">⚡ Limited Time</button>
        <button class="menu-item" data-offer="gift">🎁 Free Gift</button>
        <button class="menu-item" data-offer="go">🚀 Go Pro</button>
        <button class="menu-item" data-offer="top">🏆 Top Rated</button>
        <button class="menu-item" data-offer="trending">📈 Trending</button>
        <button class="menu-item" data-offer="secure">🔒 Secure</button>
        <button class="menu-item" data-offer="premium">⭐ Premium</button>
        <button class="menu-item" data-offer="match">🎯 Best Match</button>
        </div>
      </div>
      <form class="nav" id="navForm">
        <select id="country">
          {{#each countries}}
            <option value="{{this.code}}">{{this.flag}} {{this.name}}</option>
          {{/each}}
        </select>
        <select id="vpnMode">
          <option value="builtin">Built-in VPN</option>
          <option value="local">Local VPN</option>
        </select>
        <input id="localProxy" type="text" value="http://127.0.0.1:8080" placeholder="http://127.0.0.1:8080" style="display:none" />
        <input id="url" type="text" placeholder="Enter website or search..." />
        <button type="submit">Go</button>
        <button type="button" id="fsBtn" title="Fullscreen">⛶</button>
        <button type="button" id="homeBtn" title="Home">🏠</button>
        <button type="button" id="zoomOutBtn" title="Zoom Out">−</button>
        <button type="button" id="zoomInBtn" title="Zoom In">+</button>
        <button type="button" id="bookmarkBtn" title="Bookmark">☆</button>
        <button type="button" id="historyBtn" title="History">🕒</button>
        <button type="button" id="themeBtn" title="Toggle Theme">◐</button>
        <button type="button" id="speedBtn" title="Speed Test">⚡</button>
      </form>
      <button type="button" id="premiumPartyBtn" title="Premium Party" style="background:#e02424;color:#fff;border:0;padding:8px 12px;font-weight:900;text-transform:uppercase;border-radius:3px;cursor:pointer;">Premium Party</button>
      <div class="connection">
        <span class="dot" id="dot"></span>
        <span id="status">Disconnected</span>
      </div>
      <span id="vpnNote" class="vpn-note"></span>
    </header>

    <div class="main">
      <aside class="left-ads" id="ad-slot-left">{{{ads.left}}}</aside>

      <section class="browser">
        <div class="browser-bar">
          <span id="displayUrl">No page loaded</span>
          <button type="button" id="refreshBtn" title="Refresh Browser" style="float:right;background:#ff7a00;color:#000;border:0;padding:4px 10px;border-radius:3px;font-weight:900;font-size:11px;cursor:pointer;text-transform:uppercase;">⟳ Refresh</button>
          <button type="button" id="openTabBtn" title="Open in new tab" style="float:right;background:#ff9000;color:#000;border:0;padding:4px 10px;border-radius:3px;font-weight:900;font-size:11px;cursor:pointer;text-transform:uppercase;margin-right:6px;">↗ Open</button>
        </div>
        <div class="media-bar" id="mediaBar">
          <label class="media-field">Quality
            <select id="videoQuality">
              <option value="480">480p</option>
              <option value="720" data-premium="1">720p (Premium)</option>
              <option value="1080" data-premium="1">1080p (Premium)</option>
            </select>
          </label>
          <label class="media-field">Speed
            <select id="playbackSpeed">
              <option value="0.5">0.5x</option>
              <option value="1" selected>1x</option>
              <option value="1.25">1.25x</option>
              <option value="1.5">1.5x</option>
              <option value="2">2x</option>
            </select>
          </label>
          <label class="media-field">Subtitles
            <select id="subtitleToggle">
              <option value="off" selected>Off</option>
              <option value="on">On</option>
            </select>
          </label>
          <span id="mediaLock" class="media-lock"></span>
        </div>
        <div id="browserGate">
          <div class="gate-inner">
            <div class="gate-title">Browse for Free</div>
            <div class="gate-sub">No signup needed — or go Premium for everything</div>
            <div class="gate-btns">
              <button type="button" id="gateFreeBtn" class="gate-free">FREE</button>
              <button type="button" id="gatePremiumBtn" class="gate-premium">Premium Palace</button>
              <button type="button" id="gateCloseBtn" class="gate-close" title="Close">×</button>
            </div>
          </div>
        </div>
        <iframe id="frame" sandbox="allow-forms allow-scripts allow-popups allow-presentation allow-same-origin" allow="fullscreen"></iframe>
        <div id="fallbackMsg" style="display:none; position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:#111; color:#ff7a00; padding:20px; border:2px solid #ff7a00; border-radius:8px; z-index:10000; max-width:400px; text-align:center;">
          <h3 style="margin:0 0 10px;">Content Blocked</h3>
          <p style="margin:0 0 15px;">This site prevents embedding. <a href="#" id="openInTab" style="color:#ff7a00; text-decoration:underline; cursor:pointer;">Open in new tab</a></p>
        </div>
        <script>
          (function() {
            const frame = document.getElementById('frame');
            const fallback = document.getElementById('fallbackMsg');
            const openBtn = document.getElementById('openInTab');
            let loadFailed = false;
            
            if (frame && fallback) {
              setTimeout(() => {
                if (frame.contentWindow && frame.contentWindow.document) {
                  try {
                    const title = frame.contentWindow.document.title || '';
                    if (title.toLowerCase().includes('blocked') || title.toLowerCase().includes('refused') || !frame.src.includes('proxy?url=')) {
                      showFallback();
                    }
                  } catch (e) {
                    showFallback();
                  }
                } else {
                  showFallback();
                }
              }, 3000);
              
              window.addEventListener('message', function(e) {
                if (e.data && (e.data.includes('X-Frame-Options') || e.data.includes('blocked'))) {
                  showFallback();
                }
              });
            }
            
            function showFallback() {
              if (loadFailed) return;
              loadFailed = true;
              fallback.style.display = 'block';
              frame.style.display = 'none';
            }
            
            if (openBtn) {
              openBtn.addEventListener('click', function(e) {
                e.preventDefault();
                const currentDisplay = document.getElementById('displayUrl')?.textContent;
                if (currentDisplay) {
                  window.open('https://' + currentDisplay, '_blank');
                } else {
                  window.open(frame?.src?.replace('/proxy?url=', '').replace('&premium=0', ''), '_blank');
                }
              });
            }
          })();
        </script>
      </section>

      <aside class="right-ads" id="ad-slot-right">{{{ads.right}}}</aside>
    </div>

    <footer class="ad-slot ad-bottom">
      {{{ads.bottom}}}
      <div id="paidAds">
        {{#each paidAds}}
          {{#if this.paid}}
          <a class="paid-ad" href="{{this.url}}" target="_blank" rel="noopener">
            {{#if this.image}}<img src="{{this.image}}" alt="{{this.label}}" />{{/if}}
            <span class="paid-ad-label">{{this.label}}</span>
          </a>
          {{/if}}
        {{/each}}
      </div>
    </footer>
  </div>

  <script>
    // Disable right-click everywhere on this page
    document.addEventListener('contextmenu', (e) => { e.preventDefault(); return false; });

    // Server-rendered customizable tease buttons (label + destination)
    window.AD_BUTTONS = {{{adButtonsJson}}};

    const SPLASH = {
      title: document.getElementById('splashTitle')?.textContent || 'Premium Required',
      body: document.getElementById('splashBody')?.textContent || 'Search is for premium users only.',
      links: [
        { href: 'https://www.google.com', text: 'Google' },
        { href: 'https://www.github.com', text: 'GitHub' },
        { href: 'https://www.wikipedia.org', text: 'Wikipedia' },
      ],
    };

    function applySplash() {
      const title = document.getElementById('splashTitle');
      const body = document.getElementById('splashBody');
      const container = document.getElementById('splashLinks');
      if (title) title.textContent = SPLASH.title;
      if (body) body.textContent = SPLASH.body;
      if (container) {
        container.innerHTML = '';
        SPLASH.links.forEach(link => {
          const a = document.createElement('a');
          a.className = 'pill';
          a.href = link.href;
          a.target = '_blank';
          a.rel = 'noopener';
          a.textContent = link.text;
          container.appendChild(a);
        });
      }
    }

    applySplash();

    const premiumPartyBtn = document.getElementById('premiumPartyBtn');
    const loginMenu = document.getElementById('loginMenu');
    const loginForm = document.getElementById('loginForm');
    const loginMsg = document.getElementById('loginMsg');
    const loginClose = document.getElementById('loginClose');

    if (premiumPartyBtn) {
      premiumPartyBtn.addEventListener('click', () => {
        window.location.href = '/premium';   // Premium Party button -> payment wall
      });
    }
    if (loginClose && loginMenu) {
      loginClose.addEventListener('click', () => {
        loginMenu.style.display = 'none';
      });
    }
    if (loginForm) {
      loginForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const user = document.getElementById('loginUser').value.trim();
        const pass = document.getElementById('loginPass').value;
        if (!user || !pass) { loginMsg.textContent = 'Enter username and password'; return; }
        loginMsg.textContent = 'Checking...';
