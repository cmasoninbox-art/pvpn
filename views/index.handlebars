    // flashes a Mortal Kombat-style "TERMINATED" screen, then redirects to google.com.
    (function () {
      const btn = document.getElementById('floatingLogout');
      if (!btn) return;
      btn.addEventListener('click', () => {
        try { localStorage.removeItem('freeAccess'); localStorage.removeItem('premium'); } catch (_) {}
        const frame = document.getElementById('frame');
        if (frame) { frame.style.pointerEvents = 'none'; frame.src = 'about:blank'; }
        const term = document.getElementById('terminatedScreen');
        if (term) term.classList.add('show');
        setTimeout(() => { window.location.href = 'https://www.google.com'; }, 2200);
      });
    })();
