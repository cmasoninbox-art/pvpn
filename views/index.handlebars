        try { localStorage.setItem('ageChoice', JSON.stringify(record)); } catch (_) {}
      }

      function getChoice() {
        try {
          const raw = localStorage.getItem('ageChoice');
          if (!raw) return null;
          const record = JSON.parse(raw);
          if (Date.now() - record.ts > 3600000) {
            localStorage.removeItem('ageChoice');
            return null;
          }
          return record.value;
        } catch (_) {
          return null;
        }
      }

