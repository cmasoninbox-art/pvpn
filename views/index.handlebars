<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VPN Browser</title>
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    #ageGate {
      position: fixed;
      inset: 0;
      background: #000;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      color: #ff7a00;
      font-family: Arial, sans-serif;
    }
    #ageGate .box {
      background: #111;
      border: 2px solid #ff7a00;
      padding: 24px 28px;
      max-width: 420px;
      width: 90%;
      text-align: center;
      border-radius: 6px;
      box-shadow: 0 0 40px rgba(255,122,0,0.25);
    }
    #ageGate h2 {
      margin: 0 0 12px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }
    #ageGate p {
      color: #ccc;
      margin: 0 0 18px;
    }
    #ageGate .actions {
      display: flex;
      gap: 12px;
      justify-content: center;
    }
    #ageGate button {
      background: #ff7a00;
      color: #000;
      border: 0;
      padding: 10px 16px;
      font-weight: 900;
      text-transform: uppercase;
      cursor: pointer;
      border-radius: 4px;
    }
    #ageGate button.no {
      background: #333;
      color: #ff7a00;
      border: 1px solid #ff7a00;
    }
    #premiumGate {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.85);
      align-items: center;
      justify-content: center;
      z-index: 9999;
      font-family: Arial, sans-serif;
    }
    #premiumGate .box {
      background: #111;
      border: 2px solid #ff7a00;
      padding: 24px 28px;
      max-width: 520px;
      width: 92%;
      text-align: center;
      border-radius: 6px;
      box-shadow: 0 0 40px rgba(255,122,0,0.25);
      color: #ff7a00;
    }
    #premiumGate h2 {
      margin: 0 0 10px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }
    #premiumGate p {
      color: #ccc;
      margin: 0 0 16px;
    }
    #premiumGate .actions {
      display: flex;
      gap: 12px;
      justify-content: center;
    }
    #premiumGate button {
      background: #ff7a00;
      color: #000;
      border: 0;
      padding: 10px 16px;
      font-weight: 900;
      text-transform: uppercase;
      cursor: pointer;
      border-radius: 4px;
    }
    #premiumGate .pill {
      display: inline-block;
      background: #ff7a00;
      color: #000;
      text-decoration: none;
      padding: 10px 14px;
      font-weight: 900;
      text-transform: uppercase;
      border-radius: 4px;
    }
    #premiumGate .pill:hover {
      background: #e56d00;
    }
    #loginMenu {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.85);
      align-items: center;
      justify-content: center;
      z-index: 9998;
      font-family: Arial, sans-serif;
    }
    #loginMenu .box {
      background: #111;
      border: 2px solid #ff7a00;
      padding: 24px 28px;
      max-width: 360px;
      width: 92%;
      text-align: center;
      border-radius: 6px;
      box-shadow: 0 0 40px rgba(255,122,0,0.25);
      color: #ff7a00;
    }
    #loginMenu h2 {
      margin: 0 0 10px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }

    /* Browser-section gate: SEE-THROUGH box over JUST the browser area (not full screen).
       Big yellow FREE button + Premium Palace login button, centered. */
    .browser { position: relative; }
    #browserGate {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0,0,0,0.65);   /* see-through, not a solid block */
      backdrop-filter: blur(4px);
      width: 90%;
      max-width: 500px;
    }
    #browserGate.hidden { display: none; }
    .gate-inner {
      text-align: center;
      padding: 28px 32px;
      background: rgba(10,10,10,0.85);
      border: 2px solid rgba(255,122,0,0.6);
      border-radius: 12px;
      max-width: 460px;
      width: 100%;
      box-shadow: 0 0 60px rgba(255,122,0,0.2);
    }
    .gate-title {
      color: #fff;
      font-size: 22px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 6px;
    }
    .gate-sub {
      color: #ff9000;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 20px;
    }
    .gate-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
    .gate-free {
      background: #ff9000;            /* big yellow FREE button */
      color: #000;
      border: 0;
      border-radius: 8px;
      padding: 20px 32px;
      min-width: 180px;
      font-weight: 900;
      font-size: 20px;
      text-transform: uppercase;
      letter-spacing: 1px;
      cursor: pointer;
      transition: transform 0.1s ease, filter 0.1s ease;
      box-shadow: 0 0 30px rgba(255,144,0,0.4);
    }
    .gate-free:hover { transform: translateY(-2px) scale(1.02); filter: brightness(1.08); box-shadow: 0 0 40px rgba(255,144,0,0.6); }
    .gate-premium {
      background: #111;
      color: #ff7a00;
      border: 2px solid #ff7a00;
      border-radius: 8px;
      padding: 18px 22px;
      min-width: 160px;
      font-weight: 900;
      font-size: 15px;
      text-transform: uppercase;
      letter-spacing: 1px;
      cursor: pointer;
      transition: background 0.1s ease, color 0.1s ease;
    }
    .gate-premium:hover { background: #ff7a00; color: #000; }
    .gate-close {
      background: #111;
      color: #ff7a00;
      border: 2px solid #ff7a00;
      border-radius: 50%;
      width: 44px;
      height: 44px;
      font-size: 24px;
      font-weight: 900;
      line-height: 1;
      cursor: pointer;
      transition: background 0.1s ease, color 0.1s ease;
      align-self: center;
    }
    .gate-close:hover { background: #ff7a00; color: #000; }

    /* Themes (applied via body.theme-X) */
    body.theme-default { --bg: #000; --accent: #ff7a00; --text: #fff; }
    body.theme-dark { --bg: #0a0a0a; --accent: #ff7a00; --text: #e8e8e8; }
    body.theme-blue { --bg: #04101f; --accent: #36a3ff; --text: #cfe6ff; }
    body.theme-green { --bg: #06140c; --accent: #2ecc71; --text: #d6ffe6; }
    body.theme-purple { --bg: #120618; --accent: #b06bff; --text: #ecd6ff; }
    body.theme-light { --bg: #f2f2f2; --accent: #ff7a00; --text: #111; }
    body { background: var(--bg, #000); color: var(--text, #fff); }
    .toolbar { background: var(--bg, #000); }
    .premium-party, .tease-btn { background: var(--accent, #ff7a00); }
    #premiumPartyBtn { background: #e02424 !important; color: #fff !important; }
    .vpn-note, a { color: var(--accent, #ff7a00); }

    /* Paid ads rendered on the site */
    .paid-ad { display: block; margin: 10px auto; max-width: 90%; border: 1px solid var(--accent, #ff7a00); border-radius: 6px; overflow: hidden; text-decoration: none; }
    .paid-ad img { display: block; width: 100%; }
    .paid-ad .paid-ad-label { display: block; padding: 6px 10px; color: var(--accent, #ff7a00); font-weight: 700; text-transform: uppercase; font-size: 12px; }

    /* Big red END SESSION floating button (bottom-left) */
    #floatingLogout {
      position: fixed;
      left: 16px;
      bottom: 16px;
      z-index: 9000;
      background: #e11d1d;
      color: #fff;
      border: 2px solid #ff0000;
      border-radius: 10px;
      padding: 16px 22px;
      font-size: 18px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 0 0 22px rgba(255,0,0,0.55);
    }
    #floatingLogout:hover { filter: brightness(1.12); transform: scale(1.04); }

    /* Mortal Kombat style TERMINATED screen */
    #terminatedScreen {
      position: fixed;
      inset: 0;
      z-index: 9998;
      background: #000;
      display: none;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: #ff0000;
      font-family: 'Impact', 'Arial Black', sans-serif;
    }
    #terminatedScreen.show { display: flex; }
    #terminatedScreen .mk-wrap { animation: mkPulse 0.5s ease-in-out infinite alternate; }
    #terminatedScreen .mk-top { font-size: 28px; letter-spacing: 4px; color: #fff; text-shadow: 0 0 12px #ff0000; }
    #terminatedScreen .mk-word { font-size: 120px; line-height: 1; letter-spacing: 8px; text-shadow: 0 0 30px #ff0000, 0 0 60px #ff0000; }
    #terminatedScreen .mk-sub { font-size: 22px; letter-spacing: 6px; color: #ff5252; margin-top: 10px; }
    @keyframes mkPulse { from { transform: scale(0.96); } to { transform: scale(1.06); } }

    /* Mobile layout */
    @media (max-width: 760px) {
      html, body { width: 100%; min-width: 0; overflow-x: hidden; }
      body { margin: 0; }
      #ageGate, #premiumGate, #loginMenu, #extPrompt {
        box-sizing: border-box;
        padding: 12px;
        align-items: flex-start !important;
        overflow-y: auto;
      }
      #ageGate .box, #premiumGate .box, #loginMenu .box, #extPrompt > div {
        box-sizing: border-box;
        width: 100% !important;
        max-width: 460px !important;
        margin: auto !important;
        padding: 22px 18px !important;
      }
      #ageGate .actions, #premiumGate .actions {
        flex-direction: column;
      }
      #ageGate button, #premiumGate button, #premiumGate .pill {
        width: 100%;
        box-sizing: border-box;
      }
      .layout { width: 100%; min-width: 0; overflow: hidden; }
      .ad-top { max-height: 72px; overflow: hidden; }
      .top-banner { width: 100%; height: auto; max-height: 72px; object-fit: cover; }
      .toolbar {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 8px;
      }
      .brand { flex: 1 1 auto; min-width: 0; }
      .menu-dropdown {
        position: fixed !important;
        left: 8px !important;
        right: 8px !important;
        top: 52px !important;
        width: auto !important;
        max-height: calc(100dvh - 64px);
        overflow-y: auto;
        z-index: 10020;
      }
      .nav {
        order: 5;
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        gap: 6px;
      }
      .nav select, .nav input, .nav button {
        box-sizing: border-box;
        min-width: 0;
        max-width: 100%;
      }
      #country, #vpnMode { grid-column: span 1; }
      #url, #localProxy { grid-column: 1 / 3; width: 100%; }
      #premiumPartyBtn { margin-left: auto; }
      .connection { white-space: nowrap; }
      .vpn-note { flex: 1 1 100%; overflow-wrap: anywhere; }
      .main { display: block !important; width: 100%; min-width: 0; }
      .left-ads, .right-ads { display: none !important; }
      .browser { box-sizing: border-box; width: 100% !important; min-width: 0; }
      .browser-bar {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
        min-width: 0;
        padding: 7px;
      }
      #displayUrl {
        flex: 1 1 100%;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      #refreshBtn, #openTabBtn { float: none !important; margin: 0 !important; }
      .media-bar {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        display: grid !important;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 6px;
        padding: 7px;
      }
      .media-field { min-width: 0; }
      .media-field select { box-sizing: border-box; width: 100%; min-width: 0; }
      .media-lock { grid-column: 1 / -1; overflow-wrap: anywhere; }
      #frame, iframe#frame, iframe[name="frame"] {
        display: block;
        box-sizing: border-box;
        position: static !important;
        top: auto !important;
        left: auto !important;
        z-index: auto !important;
        max-height: none !important;
        width: 100% !important;
        min-width: 0;
        height: calc(100dvh - 250px) !important;
        min-height: 420px;
      }
      #browserGate {
        box-sizing: border-box;
        width: calc(100% - 24px) !important;
        max-height: calc(100dvh - 24px);
        overflow-y: auto;
      }
      .gate-inner { box-sizing: border-box; padding: 22px 16px; }
      .gate-btns { flex-direction: column; }
      .gate-free, .gate-premium { box-sizing: border-box; width: 100%; min-width: 0; }
      #fallbackMsg {
        box-sizing: border-box;
        width: calc(100% - 24px);
        max-width: none !important;
      }
      #extPrompt > div > div { flex-direction: column; }
      #extPrompt button:not([aria-label="Close"]) { width: 100%; }
    }
    @media (max-width: 430px) {
      #country, #vpnMode, #url, #localProxy { grid-column: 1 / -1; }
      .media-bar { grid-template-columns: 1fr; }
      .media-lock { grid-column: 1; }
      #premiumPartyBtn { font-size: 11px; padding: 7px 9px !important; }
      .connection { font-size: 12px; }
      #frame, iframe#frame, iframe[name="frame"] { height: calc(100dvh - 310px) !important; min-height: 360px; }
    }

    /* Mobile visual polish */
    @media (max-width: 760px) {
      html { background: #070707; }
      body {
        background:
          radial-gradient(circle at 50% -20%, rgba(255, 122, 0, 0.16), transparent 38%),
          #070707;
        color: #f7f7f7;
        font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        -webkit-tap-highlight-color: transparent;
      }
      button, select, input { font: inherit; }
      #ageGate, #premiumGate, #loginMenu, #extPrompt {
        background:
          radial-gradient(circle at 50% 15%, rgba(255, 122, 0, 0.16), transparent 42%),
          rgba(0, 0, 0, 0.94) !important;
        backdrop-filter: blur(14px);
        padding:
          max(16px, env(safe-area-inset-top))
          max(14px, env(safe-area-inset-right))
          max(16px, env(safe-area-inset-bottom))
          max(14px, env(safe-area-inset-left));
      }
      #ageGate .box, #premiumGate .box, #loginMenu .box, #extPrompt > div {
        background: linear-gradient(160deg, #191919 0%, #0d0d0d 68%) !important;
        border: 1px solid rgba(255, 145, 32, 0.7) !important;
        border-radius: 22px !important;
        box-shadow:
          0 24px 70px rgba(0, 0, 0, 0.72),
          0 0 0 1px rgba(255, 122, 0, 0.08) inset,
          0 0 38px rgba(255, 122, 0, 0.1) !important;
      }
      #ageGate h2, #premiumGate h2, #loginMenu h2, #extPrompt h3 {
        color: #fff !important;
        font-size: clamp(22px, 7vw, 30px);
        line-height: 1.05;
        letter-spacing: -0.5px !important;
        text-transform: none !important;
      }
      #ageGate p, #premiumGate p, #extPrompt p {
        color: #bcbcbc !important;
        line-height: 1.55 !important;
      }
      #ageGate .actions, #premiumGate .actions { gap: 10px; }
      #ageGate button, #premiumGate button, #premiumGate .pill,
      #loginMenu button[type="submit"], #extPrompt button:not([aria-label="Close"]) {
        min-height: 48px;
        border-radius: 12px !important;
        font-weight: 800 !important;
        letter-spacing: 0.2px;
        box-shadow: 0 8px 22px rgba(255, 122, 0, 0.16);
      }
      #ageGate button:not(.no), #premiumGate button,
      #loginMenu button[type="submit"] {
        background: linear-gradient(135deg, #ff9d24, #ff7000) !important;
      }
      #ageGate button.no {
        background: #171717 !important;
        border-color: #3a3a3a !important;
        color: #d6d6d6 !important;
      }
      #loginMenu input {
        box-sizing: border-box;
        width: 100%;
        min-height: 48px;
        padding: 0 14px !important;
        border: 1px solid #343434 !important;
        border-radius: 12px !important;
        background: #090909 !important;
        color: #fff !important;
        font-size: 16px;
      }
      .toolbar {
        position: sticky;
        top: 0;
        z-index: 300;
        padding:
          max(9px, env(safe-area-inset-top))
          max(10px, env(safe-area-inset-right))
          10px
          max(10px, env(safe-area-inset-left));
        background: rgba(10, 10, 10, 0.96);
        border-bottom: 1px solid rgba(255, 122, 0, 0.22);
        box-shadow: 0 12px 34px rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(16px);
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #fff;
        font-size: 17px;
        font-weight: 850;
        letter-spacing: -0.3px;
      }
      #menuBtn {
        width: 40px;
        height: 40px;
        padding: 0;
        border: 1px solid #363636;
        border-radius: 12px;
        background: #171717;
        color: #ff9220;
        font-size: 19px;
      }
      #premiumPartyBtn {
        min-height: 38px;
        padding: 0 13px !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        border-radius: 999px !important;
        background: linear-gradient(135deg, #f13d36, #b90f22) !important;
        box-shadow: 0 7px 20px rgba(206, 22, 38, 0.24);
      }
      .connection {
        min-height: 32px;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 0 11px;
        border: 1px solid #303030;
        border-radius: 999px;
        background: #141414;
        color: #bdbdbd;
      }
      .nav {
        padding: 8px;
        border: 1px solid #292929;
        border-radius: 16px;
        background: #101010;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
      }
      .nav select, .nav input, .nav button {
        min-height: 44px;
        border: 1px solid #303030 !important;
        border-radius: 10px !important;
        background: #181818 !important;
        color: #f4f4f4 !important;
        outline: none;
      }
      .nav input { padding: 0 13px !important; }
      .nav select { padding: 0 9px !important; }
      #url { font-size: 16px !important; }
      .nav button { padding: 0 10px !important; }
      .nav button[type="submit"] {
        border: 0 !important;
        background: linear-gradient(135deg, #ffa126, #ff7100) !important;
        color: #090909 !important;
        font-weight: 900;
        box-shadow: 0 6px 18px rgba(255, 122, 0, 0.2);
      }
      .menu-dropdown {
        padding: 8px;
        border: 1px solid #303030;
        border-radius: 16px;
        background: rgba(13, 13, 13, 0.98);
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(18px);
      }
      .menu-item { border-radius: 9px; }
      .browser {
        background: #080808;
        border-top: 1px solid rgba(255, 255, 255, 0.04);
      }
      .browser-bar {
        padding: 9px 10px;
        border-bottom: 1px solid #292929;
        background: #111;
      }
      #displayUrl {
        padding: 3px 2px;
        color: #a7a7a7;
        font-size: 12px;
      }
      #refreshBtn, #openTabBtn {
        min-height: 34px;
        padding: 0 12px !important;
        border-radius: 9px !important;
      }
      .media-bar {
        padding: 8px 10px;
        border-bottom: 1px solid #282828;
        background: #0c0c0c;
      }
      .media-field {
        box-sizing: border-box;
        padding: 8px;
        border: 1px solid #292929;
        border-radius: 11px;
        background: #151515;
        color: #9f9f9f;
        font-size: 10px;
        font-weight: 750;
        letter-spacing: 0.5px;
        text-transform: uppercase;
      }
      .media-field select {
        min-height: 34px;
        margin-top: 5px;
        padding: 0 7px;
        border: 0;
        border-radius: 8px;
        background: #080808;
        color: #fff;
        font-size: 13px;
        text-transform: none;
      }
      .media-lock {
        padding: 2px 4px;
        color: #ff9220;
        font-size: 11px;
      }
      #frame, iframe#frame, iframe[name="frame"] {
        background: #000;
        border-top: 1px solid rgba(255, 122, 0, 0.12) !important;
      }
      #browserGate {
        border-radius: 22px;
        background: rgba(5, 5, 5, 0.72);
        box-shadow: 0 22px 70px rgba(0, 0, 0, 0.65);
        backdrop-filter: blur(18px);
      }
      .gate-inner {
        border: 1px solid rgba(255, 145, 32, 0.62);
        border-radius: 20px;
        background: linear-gradient(160deg, rgba(28, 28, 28, 0.98), rgba(10, 10, 10, 0.98));
      }
      .gate-title {
        color: #fff;
        font-size: 25px;
        letter-spacing: -0.5px;
        text-transform: none;
      }
      .gate-sub { line-height: 1.45; }
      .gate-free, .gate-premium {
        min-height: 50px;
        border-radius: 13px;
        box-shadow: 0 9px 24px rgba(255, 122, 0, 0.14);
      }
      #fallbackMsg {
        border: 1px solid #ff8b19 !important;
        border-radius: 18px !important;
        background: rgba(15, 15, 15, 0.98) !important;
        box-shadow: 0 22px 60px rgba(0, 0, 0, 0.65);
      }
      #extPrompt > div > div { gap: 9px !important; }
      #extPrompt button:not([aria-label="Close"]) {
        min-height: 46px;
        margin: 0;
      }
    }
    @media (max-width: 430px) {
      .toolbar { gap: 7px; }
      .brand { font-size: 16px; }
      #premiumPartyBtn { font-size: 10px !important; }
      .nav { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      #country { grid-column: 1 / 3; }
      #vpnMode { grid-column: 3 / 5; }
