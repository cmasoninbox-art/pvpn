{
  "manifest_version": 3,
  "name": "Pornhub Local Iframe (Firefox, Development Only)",
  "version": "1.0.0",
  "description": "Locally removes framing-related response headers from www.pornhub.com for iframe development testing.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.pornhub.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "pornhub_iframe_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pornhub-local-iframe@example.local",
      "strict_min_version": "128.0"
    }
  }
}
