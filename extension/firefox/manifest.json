{
  "manifest_version": 3,
  "name": "PVPN Firefox Frame Helper",
  "version": "1.1.1",
  "description": "Allows PVPN to embed supported sites by removing only framing response headers.",
  "browser_specific_settings": {
    "gecko": {
      "id": "vpn-proxy-helper@pvpn.onrender.com",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://pvpn.onrender.com/*",
    "https://*.pornhub.com/*",
    "https://*.xvideos.com/*",
    "https://*.xnxx.com/*",
    "https://*.youporn.com/*"
  ],
  "action": {
    "default_title": "PVPN Firefox Helper"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pvpn.onrender.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "frame_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
